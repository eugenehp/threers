#usda 1.0
(
    defaultPrim = "Root"
)

def Scope "Root"
{
    def Scope "Holder" (
        prepend references = [@a.usda@, @b.usda@]
    )
    {
    }

    def Scope "Ordered"
    {
        reorder nameChildren = ["Third", "First", "Second"]

        def Scope "First" {}
        def Scope "Second" {}
        def Scope "Third" {}
    }
}
