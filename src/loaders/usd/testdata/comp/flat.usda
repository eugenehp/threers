#usda 1.0
(
    defaultPrim = "Room"
)

def Xform "Room"
{
    def Xform "Chair1"
    {
        color3f primvars:displayColor = (0.7, 0.7, 0.75)
        uniform token purpose = "render"
        double weight = 10
        double3 xformOp:translate = (9, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Seat"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        }
    }
}

